      "id": "preset-glycerol-water",
      "name": "Glycerol/water 50%",
      "builtIn": true,
      "densityKgM3": 1131.1,
      "dynamicViscosityPaS": 0.00839402,
      "thermalConductivityWmK": 0.4231,
      "specificHeatCapacityJkgK": 3203,
      "inletTemperatureC": 20,
      "glycerolVolumePercent": 50,
      "note": "Adjust the glycerol percentage to tune viscosity — the relationship is strongly non-linear."
    },
    {
      "id": "preset-blood-analog",
      "name": "Blood-mimicking analog",
      "builtIn": true,
      "densityKgM3": 1104.5,
      "dynamicViscosityPaS": 0.00482772,
      "thermalConductivityWmK": 0.4547,
      "specificHeatCapacityJkgK": 3380,
      "inletTemperatureC": 20,
      "glycerolVolumePercent": 40,
      "nonNewtonianNote": "Whole blood is shear-thinning: its apparent viscosity falls from ~10 mPa·s at low shear to ~3.5 mPa·s above roughly 100 s⁻¹. This analog is a Newtonian glycerol/water blend matched to that high-shear value, which is the right regime for most microchannels. At very low shear rates it will under-predict the real thing."
    }
  ],
